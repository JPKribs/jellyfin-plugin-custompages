<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.CustomPages</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.10">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.10">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.7.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Admin dashboard pages -->
    <EmbeddedResource Include="Configuration\custompages_pages.html" />
    <EmbeddedResource Include="Configuration\custompages_pages.js" />
    <EmbeddedResource Include="Configuration\custompages_assets.html" />
    <EmbeddedResource Include="Configuration\custompages_assets.js" />
    <!-- Served-page templates (rendered by PageService) -->
    <EmbeddedResource Include="Templates\custompages_wrapper.html" />
    <EmbeddedResource Include="Templates\custompages_inner.html" />
    <EmbeddedResource Include="Templates\custompages_shell.html" />
  </ItemGroup>

</Project>
